# Copy this file to .env and add local credentials. Never commit .env.
COINGECKO_API_KEY=
COINGECKO_API_BASE=https://api.coingecko.com/api/v3

# Optional H4 source. Use a consensus-layer archive endpoint; the URL may contain
# a provider token and is therefore loaded only from local .env/environment.
ETH_BEACON_ARCHIVE_API_URL=

# Free Dune API key used to collect exact BNB daily active-address and
# transaction counts. Create locally at https://dune.com/settings/api.
DUNE_API_KEY=
